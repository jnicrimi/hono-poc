{
  "name": "@hono-poc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test": "vitest run --reporter=dot",
    "test:coverage": "vitest run --reporter=dot --coverage",
    "test:unit": "vitest run --reporter=dot --project unit",
    "test:integration": "vitest run --reporter=dot --project integration",
    "test:api": "vitest run --reporter=dot --project api",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@scalar/hono-api-reference": "0.11.16",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono-poc/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
